# ============================================================
# mohamedabukhadra.com — environment
# Copy to .env and fill in. Never commit the filled-in file.
# ============================================================

# ────────────── Core ──────────────
# PostgreSQL (Vercel Postgres). A file: URL will NOT work in production —
# Vercel's filesystem is ephemeral, so a SQLite database empties on cold start
# and DB-driven pages start returning 404s to Googlebot.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# NEXT_PUBLIC_SITE_URL is intentionally NOT read anywhere in the app anymore.
# It used to back the canonical/og:url on /insights and the auto-publish links,
# while every other page hardcoded the www domain — and production had this set
# to the bare apex, so those pages' canonical tags pointed at a URL that
# 308-redirects to www, contradicting the sitemap. The single source of truth
# is now SITE_URL in src/lib/seo.ts. If you ever move domains, change it there
# (and in the admin's Site Base URL field at /admin/publishing, which overrides
# it for auto-publish links) — not here.

# ────────────── Admin seeding ──────────────
# Consumed by `npm run seed:admin`, which must be run once per environment.
# There is deliberately no "first login creates the admin" fallback.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mohamed Abu Khadra

# ────────────── Automation ──────────────
# Shared secret for the /api/auto-publish cron route. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ────────────── Analytics ──────────────
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_INSIGHT_PARTNER_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# ────────────── Email (Resend) ──────────────
# resend.com → API Keys. The sending domain must be verified in Resend first,
# or every send is rejected.
RESEND_API_KEY=
EMAIL_FROM=Mohamed Abu Khadra <hello@mohamedabukhadra.com>

# A link to the hosted Chapter 10 ("The Reset") PDF or page — e.g. upload the
# file to /public and set this to https://www.mohamedabukhadra.com/reset-chapter.pdf.
# Read by /api/newsletter's welcome email. Until this is set, a /free signup
# still gets a welcome email (that gap is fixed), but the honest generic one
# rather than one promising a chapter link, since there's nothing to link to yet.
FREE_CHAPTER_URL=

# ────────────── Social distribution ──────────────
# Make.com scenario webhook. Receives the published article and fans it out to
# LinkedIn / X / Facebook. Set this in the admin's auto-publish config, or here
# as the default.
MAKE_WEBHOOK_URL=
